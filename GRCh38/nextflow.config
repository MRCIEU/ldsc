process {
    withName:get_sample_lists {
        container = 'mrcieu/ldsc:gu-v0.15.0'
        shell = ['/bin/sh', '-ue']
    }
    withName:subset_vcfs {
        container = 'mrcieu/ldsc:bcftools-1.22'
    }
    withName:vcf_2_bfile_plus_map {
        container = 'mrcieu/ldsc:plink-1.9'
        shell = ['/bin/sh', '-ue']
    }
    withName:get_ldscores {
        container = 'mrcieu/ldsc:ldsc-9c78156-python3.9'
        maxForks = 1
    }
}

docker {
    enabled = true
    runOptions = "--cpus='8'"
}
